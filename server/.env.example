# --- Server ---
PORT=3000
# Comma-separated list of allowed front-end origins
CLIENT_URL=http://localhost:8080

# --- Clerk (https://dashboard.clerk.com) ---
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Slug of the paid plan you create in Clerk Billing
PREMIUM_PLAN_SLUG=premium
# Comma-separated Clerk user IDs (user_...) that get full Premium access without paying
ADMIN_USER_IDS=

# --- Neon Postgres (https://neon.tech) ---
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# --- AI providers ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CLIPDROP_API_KEY=

# --- Cloudinary (image storage + object removal) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Limits ---
FREE_MONTHLY_LIMIT=10
MAX_UPLOAD_MB=4
